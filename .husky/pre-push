# Pre-push hook: Run full checks (lint + typecheck + tests)
# Uses hook-runtime for AI-aware, non-blocking error handling

# Skip if SKIP_HOOKS is set (for emergency pushes)
if [ -n "$SKIP_HOOKS" ]; then
  echo "⚠️  SKIP_HOOKS is set, skipping pre-push checks"
  exit 0
fi

# Fix Windows git-bash TEMP resolution (git bash sets TEMP=/tmp,
# which causes Node.js mkdtemp to fail with ENOENT on Windows)
if [ "$(uname -s 2>/dev/null | cut -c1-5)" = "MINGW" ] || [ "$(uname -s 2>/dev/null | cut -c1-10)" = "MSYS_NT" ]; then
  win_temp="$(cygpath -w "$LOCALAPPDATA/Temp" 2>/dev/null || echo "$USERPROFILE/AppData/Local/Temp")"
  export TEMP="$win_temp"
  export TMP="$win_temp"
fi

# Ensure the Rust toolchain is reachable from non-interactive shells
# (GUI clients and agent harnesses do not source ~/.zshrc, so cargo-based
# metrics like clippy_pass/rust_test_pass silently fail without this).
if ! command -v cargo >/dev/null 2>&1 && [ -x "$HOME/.cargo/bin/cargo" ]; then
  export PATH="$HOME/.cargo/bin:$PATH"
fi

# Ensure entrix is reachable: metrics such as graph_test_mapping_probe call
# a bare `entrix`, which is rarely installed globally. Fall back to the
# locally built binary, mirroring the post-commit hook's ENTRIX_BIN logic.
if ! command -v entrix >/dev/null 2>&1 && [ -x "./target/debug/entrix" ]; then
  export PATH="$(pwd)/target/debug:$PATH"
fi

# ─── Run Standard Checks ───────────────────────────────────────────
# Run hook runtime directly for full pre-push checks.
node --import tsx tools/hook-runtime/src/cli.ts --profile pre-push "$@"
