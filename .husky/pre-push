# Pre-push hook: Run full checks (lint + typecheck + tests)
# Uses hook-runtime for AI-aware, non-blocking error handling

# Skip if SKIP_HOOKS is set (for emergency pushes)
if [ -n "$SKIP_HOOKS" ]; then
  echo "⚠️  SKIP_HOOKS is set, skipping pre-push checks"
  exit 0
fi

# Fix Windows git-bash TEMP resolution (git bash sets TEMP=/tmp,
# which causes Node.js mkdtemp to fail with ENOENT on Windows)
if [ "$(uname -s 2>/dev/null | cut -c1-5)" = "MINGW" ] || [ "$(uname -s 2>/dev/null | cut -c1-10)" = "MSYS_NT" ]; then
  win_temp="$(cygpath -w "$LOCALAPPDATA/Temp" 2>/dev/null || echo "$USERPROFILE/AppData/Local/Temp")"
  export TEMP="$win_temp"
  export TMP="$win_temp"
fi

# Ensure the Rust toolchain is reachable from non-interactive shells
# (GUI clients and agent harnesses do not source ~/.zshrc, so cargo-based
# metrics like clippy_pass/rust_test_pass silently fail without this).
if ! command -v cargo >/dev/null 2>&1 && [ -x "$HOME/.cargo/bin/cargo" ]; then
  export PATH="$HOME/.cargo/bin:$PATH"
fi

# Ensure entrix is reachable: metrics such as graph_test_mapping_probe call
# a bare `entrix`, which is rarely installed globally. Fall back to the
# locally built binary, mirroring the post-commit hook's ENTRIX_BIN logic.
if ! command -v entrix >/dev/null 2>&1 && [ -x "./target/debug/entrix" ]; then
  export PATH="$(pwd)/target/debug:$PATH"
fi

# Checks run through `node --import tsx`; without dependencies they cannot run.
# Fail loudly instead of letting a push through unchecked (card worktrees have
# no node_modules unless one is installed or linked).
if [ ! -d node_modules/tsx ]; then
  echo "❌ pre-push: 缺 node_modules（找不到 node_modules/tsx），无法运行推送前检查，推送已拒绝。" >&2
  echo "   请在 $(pwd) 执行 pnpm install，或软链主检出的 node_modules：ln -s <主检出>/node_modules node_modules" >&2
  echo "❌ pre-push: node_modules is missing, checks cannot run; push rejected. Run pnpm install here." >&2
  exit 1
fi

# ─── Run Standard Checks ───────────────────────────────────────────
# Run hook runtime directly for full pre-push checks.
# On macOS (lockf + taskpolicy available) queue checks machine-wide behind one
# lock shared by the main checkout and every worktree, and run them at low
# priority (nice 10 + utility QoS) so parallel pushes do not saturate the CPU.
# Avoid `taskpolicy -b`: background QoS made timing-sensitive vitest flaky.
if command -v lockf >/dev/null 2>&1 && command -v taskpolicy >/dev/null 2>&1; then
  lock_file="${ROUTA_PREPUSH_LOCK_FILE:-/tmp/routa-prepush.lock}"
  lock_timeout="${ROUTA_PREPUSH_LOCK_TIMEOUT:-1800}"
  # Marker distinguishes lockf's own timeout (exit 75) from the checks' exit code.
  started_marker="$(mktemp -t routa-prepush-started)" && rm -f "$started_marker"
  if ! lockf -k -t 0 "$lock_file" true </dev/null >/dev/null 2>&1; then
    echo "⏳ 另一个推送正在跑 pre-push 检查，排队等待（最多 ${lock_timeout} 秒）…"
  fi
  lockf -k -t "$lock_timeout" "$lock_file" \
    sh -c 'touch "$0"; exec taskpolicy -c utility nice -n 10 "$@"' "$started_marker" \
    node --import tsx tools/hook-runtime/src/cli.ts --profile pre-push "$@"
  status=$?
  if [ "$status" -eq 75 ] && [ ! -e "$started_marker" ]; then
    echo "⚠️  等待 pre-push 检查锁超过 ${lock_timeout} 秒，不再排队，直接以低优先级运行检查"
    taskpolicy -c utility nice -n 10 node --import tsx tools/hook-runtime/src/cli.ts --profile pre-push "$@"
    status=$?
  fi
  rm -f "$started_marker"
  exit "$status"
fi

node --import tsx tools/hook-runtime/src/cli.ts --profile pre-push "$@"
